diff --git a/models/baselines/models.py b/models/baselines/models.py
new file mode 100644
index 0000000..09abb40
--- /dev/null
+++ b/models/baselines/models.py
@@ -0,0 +1,115 @@
+"""Reference detectors the MLP/VQC are compared against: the models a flow-level NIDS would actually
+deploy (Random Forest, gradient-boosted trees) and a single-feature statistical rule of the kind
+beacon hunters use (low inter-arrival-time CV => beacon; high throughput => bulk exfil).
+
+These deliberately use library implementations. The "no framework" rule in the README applies to the
+MLP-vs-VQC comparison (both written out so neither gets a better-optimized engine); baselines exist to
+show where that comparison sits relative to standard practice, so they should be the standard thing.
+
+Every model exposes predict_proba(X) -> (n, n_classes), predict(X), param_count(), save(), load(), so
+evasion/detector.py can wrap them exactly like the MLP and VQC.
+"""
+import json
+import pickle
+
+import numpy as np
+
+
+def _sigmoid(z):
+    return 1.0 / (1.0 + np.exp(-np.clip(z, -50, 50)))
+
+
+class ThresholdDetector:
+    """One feature, one cut. Flags the attack class when the (standardized) feature is on the attack
+    side of `threshold`. The direction and cut are fit on train to maximize balanced accuracy, so it is
+    the best possible single-threshold rule on that feature. predict_proba is a logistic of the signed
+    margin (sharpness k): exactly the rule at P=0.5, but graded, so it can be operated at any FPR."""
+
+    def __init__(self, feature_idx, feature_name, sharpness=4.0, attack_idx=1, n_classes=2):
+        self.feature_idx = int(feature_idx)
+        self.feature_name = feature_name
+        self.sharpness = float(sharpness)
+        self.attack_idx = int(attack_idx)
+        self.n_classes = int(n_classes)
+        self.threshold = None
+        self.attack_below = None   # True: attack if x < threshold (e.g. low cv_iat beacon)
+
+    def fit(self, X, y):
+        x = X[:, self.feature_idx]
+        is_att = y == self.attack_idx
+        u = np.unique(x)
+        cands = (u[:-1] + u[1:]) / 2 if len(u) > 1 else u
+        best = (-1.0, None, None)
+        for below in (True, False):
+            for t in cands:
+                pred = (x < t) if below else (x > t)
+                tpr = pred[is_att].mean() if is_att.any() else 0.0
+                tnr = (~pred[~is_att]).mean() if (~is_att).any() else 0.0
+                bal = 0.5 * (tpr + tnr)
+                if bal > best[0]:
+                    best = (bal, float(t), below)
+        _, self.threshold, self.attack_below = best
+        return self
+
+    def predict_proba(self, X):
+        x = np.atleast_2d(X)[:, self.feature_idx]
+        margin = (self.threshold - x) if self.attack_below else (x - self.threshold)
+        p_att = _sigmoid(self.sharpness * margin)
+        out = np.zeros((len(x), self.n_classes))
+        out[:, self.attack_idx] = p_att
+        out[:, 1 - self.attack_idx] = 1.0 - p_att
+        return out
+
+    def predict(self, X):
+        return np.argmax(self.predict_proba(X), axis=1)
+
+    def param_count(self):
+        return 2   # threshold + direction
+
+    def save(self, path):
+        with open(path, "w") as f:
+            json.dump({"feature_idx": self.feature_idx, "feature_name": self.feature_name,
+                       "sharpness": self.sharpness, "attack_idx": self.attack_idx,
+                       "n_classes": self.n_classes, "threshold": self.threshold,
+                       "attack_below": self.attack_below}, f, indent=2)
+
+    @classmethod
+    def load(cls, path):
+        with open(path) as f:
+            d = json.load(f)
+        m = cls(d["feature_idx"], d["feature_name"], d["sharpness"], d["attack_idx"], d["n_classes"])
+        m.threshold, m.attack_below = d["threshold"], d["attack_below"]
+        return m
+
+
+class TreeModel:
+    """Thin wrapper over a fitted sklearn RandomForestClassifier or xgboost XGBClassifier, giving it the
+    same save/load/param_count surface as the MLP and VQC."""
+
+    def __init__(self, est, kind):
+        self.est = est
+        self.kind = kind
+
+    def predict_proba(self, X):
+        return self.est.predict_proba(np.atleast_2d(X))
+
+    def predict(self, X):
+        return np.argmax(self.predict_proba(X), axis=1)
+
+    def param_count(self):
+        """Total tree nodes — the closest analogue of a parameter count for an ensemble."""
+        if self.kind == "random_forest":
+            return int(sum(t.tree_.node_count for t in self.est.estimators_))
+        df = self.est.get_booster().trees_to_dataframe()
+        return int(len(df))
+
+    def save(self, path):
+        with open(path, "wb") as f:
+            pickle.dump({"kind": self.kind, "est": self.est}, f)
+
+    @classmethod
+    def load(cls, path):
+        # only ever loads files this pipeline wrote into results/ — never an untrusted pickle
+        with open(path, "rb") as f:
+            d = pickle.load(f)
+        return cls(d["est"], d["kind"])
diff --git a/models/baselines/train.py b/models/baselines/train.py
new file mode 100644
index 0000000..1e759b5
--- /dev/null
+++ b/models/baselines/train.py
@@ -0,0 +1,120 @@
+"""Train a reference detector (Random Forest, XGBoost, or a single-feature threshold rule) on the same
+split as the MLP/VQC, on the native 17 features. Writes the same result-dir layout as the other
+trainers (model file, prep.npz, meta.json, history.npz, test_predictions.npz), so evasion scoring and
+hardening treat it like any other detector.
+
+    python -m models.baselines.train --kind rf  --data data/dataset.npz --out results/rf
+    python -m models.baselines.train --kind xgb --data data/dataset.npz --out results/xgb
+    python -m models.baselines.train --kind threshold --feature cv_iat --data data/dataset.npz \
+        --out results/threshold
+    # exfil: same, with --data data/exfil_dataset.npz and --feature bytes_per_second for the rule
+"""
+import argparse
+import json
+import time
+from pathlib import Path
+
+import numpy as np
+import yaml
+
+from features.dataset import FEATURE_NAMES, load_dataset, preprocess, train_val_test_split
+from models.baselines.models import ThresholdDetector, TreeModel
+
+KIND_TO_MODEL = {"rf": "random_forest", "xgb": "xgboost", "threshold": "threshold"}
+MODEL_FILE = {"random_forest": "model.pkl", "xgboost": "model.pkl", "threshold": "model.json"}
+
+
+def default_feature(class_names):
+    """The signal each attack family's detector keys on: timing regularity for C2, throughput for exfil."""
+    return "bytes_per_second" if "exfil" in class_names else "cv_iat"
+
+
+def _fit(kind, Xtr, ytr, Xva, yva, cfg, class_names, feature):
+    attack_idx = 1 - class_names.index("benign")
+    if kind == "random_forest":
+        from sklearn.ensemble import RandomForestClassifier
+        c = cfg["rf"]
+        est = RandomForestClassifier(n_estimators=c["n_estimators"], max_depth=c.get("max_depth"),
+                                     min_samples_leaf=c.get("min_samples_leaf", 1),
+                                     class_weight="balanced", random_state=cfg["seed"], n_jobs=-1)
+        est.fit(Xtr, ytr)
+        return TreeModel(est, kind)
+    if kind == "xgboost":
+        from xgboost import XGBClassifier
+        c = cfg["xgb"]
+        n_pos, n_neg = int((ytr == attack_idx).sum()), int((ytr != attack_idx).sum())
+        est = XGBClassifier(n_estimators=c["n_estimators"], max_depth=c["max_depth"],
+                            learning_rate=c["learning_rate"], subsample=c["subsample"],
+                            colsample_bytree=c["colsample_bytree"],
+                            scale_pos_weight=n_neg / max(n_pos, 1) if attack_idx == 1 else n_pos / max(n_neg, 1),
+                            early_stopping_rounds=c["early_stopping_rounds"], eval_metric="logloss",
+                            random_state=cfg["seed"], n_jobs=-1)
+        est.fit(Xtr, ytr, eval_set=[(Xva, yva)], verbose=False)
+        return TreeModel(est, kind)
+    if kind == "threshold":
+        m = ThresholdDetector(FEATURE_NAMES.index(feature), feature, cfg["threshold"]["sharpness"],
+                              attack_idx=attack_idx, n_classes=len(class_names))
+        return m.fit(Xtr, ytr)
+    raise ValueError(kind)
+
+
+def fit_baseline(kind, splits, cfg, class_names, out, feature=None, extra_meta=None):
+    """kind: random_forest | xgboost | threshold. splits: ((Xtr,ytr),(Xva,yva),(Xte,yte)) of RAW
+    features. Standardizes (fit on train; a monotone per-feature map, so it changes nothing for trees
+    or a single cut but keeps every detector on the same prep path), fits, evaluates, writes `out`.
+    Returns (test_accuracy, benign_fpr)."""
+    (Xtr, ytr), (Xva, yva), (Xte, yte) = splits
+    (Xtr_t, Xva_t, Xte_t), info = preprocess((Xtr, Xva, Xte))
+    feature = feature or default_feature(class_names)
+
+    start = time.perf_counter()
+    model = _fit(kind, Xtr_t, ytr, Xva_t, yva, cfg, class_names, feature)
+    train_time = time.perf_counter() - start
+
+    benign_idx = class_names.index("benign")
+    proba = model.predict_proba(Xte_t)
+    pred = np.argmax(proba, axis=1)
+    acc = float((pred == yte).mean())
+    benign = yte == benign_idx
+    fpr = float((pred[benign] != benign_idx).mean()) if benign.any() else 0.0
+
+    out = Path(out)
+    out.mkdir(parents=True, exist_ok=True)
+    model.save(out / MODEL_FILE[kind])
+    np.savez(out / "prep.npz", scaler_mean=info["scaler"].mean_, scaler_std=info["scaler"].std_)
+    np.savez(out / "history.npz")
+    np.savez(out / "test_predictions.npz", y_true=yte, y_proba=proba)
+    meta = {"model": kind, "input_mode": "native", "pca_components": None,
+            "param_count": model.param_count(), "train_time_seconds": train_time,
+            "test_accuracy": acc, "benign_fpr": fpr, "n_features": Xtr_t.shape[1],
+            "feature_names": FEATURE_NAMES, "class_names": class_names,
+            "config": cfg}
+    if kind == "threshold":
+        meta["threshold_feature"] = feature
+        meta["threshold_attack_below"] = bool(model.attack_below)
+    meta.update(extra_meta or {})
+    (out / "meta.json").write_text(json.dumps(meta, indent=2))
+    return acc, fpr
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument("--kind", required=True, choices=list(KIND_TO_MODEL))
+    p.add_argument("--data", default="data/dataset.npz")
+    p.add_argument("--config", default="configs/baselines.yaml")
+    p.add_argument("--feature", default=None,
+                   help="threshold rule feature (default: cv_iat for C2, bytes_per_second for exfil)")
+    p.add_argument("--out", required=True)
+    args = p.parse_args()
+
+    cfg = yaml.safe_load(open(args.config))
+    X, y, _, class_names = load_dataset(args.data)
+    splits = train_val_test_split(X, y, val_size=cfg["val_size"], test_size=cfg["test_size"],
+                                  seed=cfg["seed"])
+    kind = KIND_TO_MODEL[args.kind]
+    acc, fpr = fit_baseline(kind, splits, cfg, class_names, args.out, feature=args.feature)
+    print(f"[{kind}] test accuracy {acc:.4f}  benign FPR {fpr:.4f}  -> {args.out}")
+
+
+if __name__ == "__main__":
+    main()
